[Unit]
Description=LEOLaser direct-drive stand API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=laser
WorkingDirectory=/home/laser/leolaser/app
EnvironmentFile=/home/laser/leolaser/.env
ExecStart=/home/laser/leolaser/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
