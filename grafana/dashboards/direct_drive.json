{
  "uid": "direct-drive",
  "title": "Direct-drive stand",
  "tags": [
    "leolaser"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "1s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "constant",
        "query": "telemetry",
        "current": {
          "value": "telemetry",
          "text": "telemetry"
        },
        "hide": 2
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"run_id\")"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Events",
        "enable": true,
        "iconColor": "rgba(255,96,96,1)",
        "datasource": {
          "type": "influxdb",
          "uid": "influx"
        },
        "target": {
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"events\")\n  |> filter(fn: (r) => r[\"_field\"] == \"name\")"
        },
        "textField": "detail",
        "titleField": "name"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "At a glance",
