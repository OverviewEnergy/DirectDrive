MODE=direct_drive
SOURCE=sim
SAMPLE_HZ=20
STAND_ID=stand-1

# USB: no IP, no static networking, no device passthrough.
LABJACK_CONN=USB
LABJACK_ID=ANY

# If you move the T7 back to Ethernet, set these two instead:
#LABJACK_CONN=ETHERNET
#LABJACK_ID=10.1.0.244

# Measured with tools/bringup.py --zero-hass. Do not assume 2.5.
HASS_ZERO_V=2.5
HASS_SENS_V_PER_A=0.0125
HASS_TURNS=1
LJTD_RATIO=25.0

# 0.307 for the 10 mm nozzle, 0.28 for the 6 mm.
FLOW_LPM_PER_HZ=0.307
FLOW_WINDOW_S=2.0

# UNVERIFIED. Confirm against the T7 DIO-EF docs for your firmware.
DIO_EF_COUNTER_INDEX=9
DIO_EF_DEBOUNCE_US=1500

# PLACEHOLDERS. Run tools/calibrate_thermistor.py. Four-term, not three.
SH_A=0.001125
SH_B=0.000234
SH_C=0.0
SH_D=0.0000000876

CURRENT_REDLINE_A=11.0
TEMP_LIMIT_C=30.0
FLOW_MIN_LPM=2.0

COMPARATOR_WIRED=0

ONEWIRE_ENABLED=0
ONEWIRE_DQ_DIONUM=2
ONEWIRE_POLL_S=2.0
ONEWIRE_ROLES=

# api runs on the Pi host, so influx is on localhost.
# Change to http://influxdb:8086 only if running the api in Docker.
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-token
INFLUX_ORG=leolaser
INFLUX_BUCKET=telemetry

# --- field, no external network ---
# Pi hosts its own AP. It takes 10.42.0.1; the laptop joins and gets DHCP.
# Nothing here changes for the field: the api binds 0.0.0.0 and the GUI has no
# external dependencies. Set STAND_URL=http://10.42.0.1:8000 on the laptop.

# Analog channel assignment. Verify against the bench before trusting a reading.
# The LJTick-Divider-25 has TWO channels: on the AIN2/AIN3 block it drives both,
# so AIN3 is NOT free and the thermistor must go on AIN1. A discrete divider on
# AIN2 does leave AIN3 free.
CURRENT_AIN=0
VOLTAGE_AIN=2
THERMISTOR_AIN=3

# --- Ophir ---
# none       optical arrives over HTTP from bridge.py on a remote machine
# usb-linux  Pi reads the meter directly over USB. One clock domain, no bridge.
# serial     StarCom-style serial, needs OPHIR_PORT
# sim        synthetic
OPHIR_BACKEND=none
OPHIR_MODEL=juno
OPHIR_RATE_HZ=12
OPHIR_CHANNEL=0
